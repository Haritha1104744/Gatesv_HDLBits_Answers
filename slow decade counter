module top_module (
    input clk,
    input slowena,
    input reset,
    output [3:0] q);
    integer i;
    always@(posedge clk) begin 
        if(reset)
            q<=0;
        else if(slowena) begin
                if(q==4'b1001)
                    q<=0;
            else
                for(i=0;i<8;i++)
                    q<=q+1; end
        else
            q<=q;
    end
    
endmodule
